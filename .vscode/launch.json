    "version": "0.2.0",
    "configurations": [

        {
            "name": "基本的な実行",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "uv",
            "args": [
                "run",
                "python",
                "${file}",
                "--imagenet-root", "/data/ImageNet",
                "--num-classes", "1000",
                "--batch-size", "32",
                "--calibration-batches", "32",
                "--taylor-prune-amount", "0.3",
                "--model-name-nomal", "vit_base_patch16_224",
                "--model-name-comp-loop", "sret_s",
                "--model-name-loop", "loop_vit",
            ]
        }
    ]
}