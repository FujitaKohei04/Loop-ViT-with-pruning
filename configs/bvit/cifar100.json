{
  "_comment": "CIFAR-100 recipe used for all bViT / ViT runs in outputs/bvit and outputs/mgloop (2026-10/11). 32px, patch 4 -> 8x8+1 tokens. Pick the model with --model.",
  "model": "bvit_s",
  "dataset": "cifar100",
  "patch_size": 4,
  "augment": "auto",
  "re_prob": 0.25,
  "num_workers": 8,
  "epochs": 300,
  "warmup_epochs": 30,
  "warmup_start_factor": 0.033,
  "lr": 0.0005,
  "weight_decay": 0.05,
  "effective_batch": 1024,
  "batch_size": 128,
  "label_smoothing": 0.1,
  "mixup_alpha": 0.8,
  "cutmix_alpha": 1.0,
  "mixup_switch_prob": 0.5,
  "clip_grad": 1.0,
  "ema_decay": "auto",
  "amp": true,
  "seed": 42,
  "eval_interval": 1,
  "output_dir": "./outputs/bvit"
}
